{
  "ConnectionStrings": {
    "Default": "Data Source=happyInventory.db"
  },
  "Jwt": {
    "Issuer": "happyInventory",
    "Audience": "happyInventory.Client",
    "Key": "",
    "ExpiryMinutes": 480
  },
  "Seed": {
    "AdminUsername": "admin@happywarehouse.com",
    "AdminPassword": "",
    "AdminFullName": "System Administrator"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Database": {
      "Enabled": true,
      "MinimumLevel": "Information",
      "QueueCapacity": 10000,
      "RetentionDays": 30
    }
  },
  "AllowedHosts": "*"
}
